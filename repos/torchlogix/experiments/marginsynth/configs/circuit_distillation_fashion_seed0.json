{
  "method": "margin-constrained-whole-circuit-lut-resynthesis",
  "source_checkpoint": "best_checkpoint.pt",
  "eligible_logic_layers": [1, 2, 3, 4],
  "action_space": "all",
  "objective": "margin",
  "cost_kind": "aig",
  "robust_groups": true,
  "steps": 400,
  "batch_size": 256,
  "evaluation_batch_size": 512,
  "learning_rate": 0.02,
  "initial_logit_gap": 4.0,
  "forbidden_logit": -1000.0,
  "hard_logit": 1000000.0,
  "forward_sampling": "hard",
  "temperature_start": 1.0,
  "temperature_end": 0.25,
  "margin_retention": 0.5,
  "margin_reserve": 0.25,
  "margin_target_cap": 2.0,
  "stability_folds": 4,
  "cost_warmup_steps": 40,
  "gradient_clip": 5.0,
  "loss_weights": {
    "decision": 1.0,
    "class_worst": 0.5,
    "fold_worst": 0.5,
    "labels": 0.05,
    "hardware": 2.0
  },
  "budgets": {
    "accuracy_loss": 0.0033333333333333335,
    "disagreement": 0.03,
    "per_class_accuracy_loss": 0.015,
    "per_class_disagreement": 0.075
  },
  "repair": true,
  "repair_scan": 32,
  "log_every": 20,
  "seed": 0,
  "output": "distillation/margin_all_aig_seed0"
}
